# Maintainer: Vaani contributors
pkgname=vaani
pkgver=1.2.0
pkgrel=1
install=vaani.install
pkgdesc="Local-first voice dictation for Hyprland/Wayland (Rust + whisper.cpp + Quickshell)"
arch=('x86_64')
url="https://github.com/SaptodeepSarkar/ArchFlow"
license=('MIT')
# Official repo dependencies (verify with `pacman -Si <pkg>`):
depends=('pipewire' 'wl-clipboard' 'wtype' 'hyprland' 'quickshell' 'qt6-base' 'qt6-declarative' 'curl' 'gcc-libs' 'glibc')
# whisper.cpp is OPTIONAL at runtime (cpu-stub is silence-safe without it).
# For real transcription: build pinned whisper.cpp per native/worker/README.md
# or install whisper.cpp from AUR (aur/whisper.cpp) — kept optdepends on purpose.
optdepends=('whisper.cpp: local transcription backend'
            'cuda: optional GPU worker (user-selected build only)')
makedepends=('rust' 'cargo' 'cmake' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')  # release tarballs get pinned checksums; VCS builds use --skipinteg in dev only

build() {
  cd "ArchFlow-$pkgver"
  # Reproducible build inputs: locked deps via Cargo.lock, pinned toolchain.
  cargo build --locked --release
}

package() {
  cd "ArchFlow-$pkgver"
  install -Dm755 target/release/vaanid "$pkgdir/usr/bin/vaanid"
  install -Dm755 target/release/vaani "$pkgdir/usr/bin/vaani"
  install -Dm755 target/release/vaani-desktop "$pkgdir/usr/bin/vaani-desktop"
  install -Dm755 target/release/vaani-worker "$pkgdir/usr/bin/vaani-worker"
  install -Dm755 crates/vaani-worker/fw-transcribe.py "$pkgdir/usr/bin/fw-transcribe.py"
  install -Dm755 crates/vaani-worker/fw-server.py "$pkgdir/usr/bin/fw-server.py"
  install -Dm755 training/cleanup-llm/scripts/vaani_inject.py "$pkgdir/usr/bin/vaani_inject.py"
  install -Dm755 training/cleanup-llm/scripts/llm-server.py "$pkgdir/usr/bin/llm-server.py"
  install -Dm644 packaging/vaanid.service "$pkgdir/usr/lib/systemd/user/vaanid.service"
  install -Dm644 packaging/vaani.desktop "$pkgdir/usr/share/applications/vaani.desktop"
  install -Dm644 packaging/hyprland/vaani.conf "$pkgdir/usr/share/vaani/hyprland/vaani.conf"
  install -Dm644 config.example.toml "$pkgdir/usr/share/vaani/config.example.toml"
  install -Dm644 models/manifest.toml "$pkgdir/usr/share/vaani/models/manifest.toml"
  # Quickshell app-owned config (NOT the user's desktop shell):
  install -Dm644 ui/shell.qml "$pkgdir/usr/share/quickshell/vaani/shell.qml"
  install -Dm644 ui/Theme.qml "$pkgdir/usr/share/quickshell/vaani/Theme.qml"
  install -Dm644 ui/SettingsView.qml "$pkgdir/usr/share/quickshell/vaani/SettingsView.qml"
  install -Dm644 ui/OnboardingView.qml "$pkgdir/usr/share/quickshell/vaani/OnboardingView.qml"
  install -Dm644 ui/VaaniButton.qml "$pkgdir/usr/share/quickshell/vaani/VaaniButton.qml"
  install -Dm644 ui/VaaniField.qml "$pkgdir/usr/share/quickshell/vaani/VaaniField.qml"
  install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

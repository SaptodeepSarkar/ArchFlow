[Unit]
Description=Vaani voice dictation controller (per-user)
Documentation=https://github.com/SaptodeepSarkar/ArchFlow
After=pipewire.service wireplumber.service
Wants=pipewire.service
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/vaanid --foreground
Restart=on-failure
# Bounded restarts: 5 tries in 60 s, then stop hammering.
# Clean process-group teardown (no orphaned pw-record / workers).
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=5
# Hardening, compatibility-checked on Arch/systemd 261: the controller MUST
# write $XDG_RUNTIME_DIR/vaani + $HOME config/data dirs and spawn
# pw-record/wl-copy/hyprctl/quickshell, so ProtectSystem=strict and
# ProtectHome=read-only are INCOMPATIBLE (they abort startup with EROFS).
# Keep the containment that doesn't break the app's job:
NoNewPrivileges=true
PrivateTmp=true
RestrictSUIDSGID=true
UMask=0077
# The user-local installer rewrites ExecStart. XDG state/config paths are
# resolved by the binary itself.

[Install]
WantedBy=graphical-session.target

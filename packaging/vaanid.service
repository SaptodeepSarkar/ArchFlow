[Unit]
Description=Vaani voice dictation controller (per-user)
Documentation=https://github.com/SaptodeepSarkar/ArchFlow
After=pipewire.service wireplumber.service
Wants=pipewire.service
PartOf=graphical-session.target
# A controller crash must not silently make the compositor shortcut inert for
# the rest of the login session. Retry at a deliberately slow cadence rather
# than exhausting a short start-limit budget and leaving a failed unit behind.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/vaanid --foreground
Restart=always
RestartSec=5
# systemctl stop suppresses Restart=always; this only recovers an unexpected
# controller exit. Five seconds avoids a hot crash loop on a bad setup.
# Clean process-group teardown (no orphaned pw-record / workers).
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=5
# Hardening, compatibility-checked on Arch/systemd 261: the controller MUST
# write $XDG_RUNTIME_DIR/vaani + $HOME config/data dirs and spawn
# pw-record/wl-copy/hyprctl/quickshell, so ProtectSystem=strict and
# ProtectHome=read-only are INCOMPATIBLE (they abort startup with EROFS).
# Keep the containment that doesn't break the app's job:
NoNewPrivileges=true
PrivateTmp=true
RestrictSUIDSGID=true
UMask=0077
# The user-local installer rewrites ExecStart. XDG state/config paths are
# resolved by the binary itself.

[Install]
WantedBy=graphical-session.target

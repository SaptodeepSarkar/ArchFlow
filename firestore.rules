rules_version = '2';

// Firestore is a blind relay for Vaani sync. Personal words, aliases, links,
// snippets, and replacements must be compressed and encrypted on-device
// before they reach this database.
service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUser(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validEnvelope(data, recordId) {
      return data.keys().hasOnly([
          'schema_version', 'record_id', 'updated_at_ms', 'logical_clock',
          'writer_device_id', 'revision', 'compression',
          'cipher', 'nonce', 'ciphertext'
        ])
        && data.schema_version == 1
        && data.record_id == recordId
        && data.updated_at_ms is int
        && data.logical_clock is int
        && data.writer_device_id is string
        && data.writer_device_id.size() > 0 && data.writer_device_id.size() <= 128
        && data.revision is int
        && data.compression == 'gzip'
        && data.cipher == 'aes-256-gcm'
        && data.nonce is string
        && data.nonce.size() >= 16 && data.nonce.size() <= 32
        && data.ciphertext is string
        && data.ciphertext.size() > 24 && data.ciphertext.size() <= 20000;
    }

    // This mirrors vaani-core's (logical clock, writer ID, revision,
    // timestamp) total order. Metadata contains no personalized text, but
    // must remain visible so rules can atomically reject stale writes.
    function wins(data, existing) {
      return data.logical_clock > existing.logical_clock
        || (data.logical_clock == existing.logical_clock
          && (data.writer_device_id > existing.writer_device_id
            || (data.writer_device_id == existing.writer_device_id
              && (data.revision > existing.revision
                || (data.revision == existing.revision
                  && data.updated_at_ms >= existing.updated_at_ms)))));
    }

    match /users/{uid}/personalization/{recordId} {
      allow get, list: if ownsUser(uid);
      allow create: if ownsUser(uid) && validEnvelope(request.resource.data, recordId);
      allow update: if ownsUser(uid)
        && validEnvelope(request.resource.data, recordId)
        && wins(request.resource.data, resource.data);
      allow delete: if false;
    }

    // Device entries have no personal text. They permit a future notification
    // service to route an opaque "sync available" signal without learning what
    // changed. Keys and FCM tokens are device-scoped, never dictation data.
    match /users/{uid}/devices/{deviceId} {
      allow get, list: if ownsUser(uid);
      allow create, update: if ownsUser(uid)
        && request.resource.data.keys().hasOnly(['schema_version', 'device_id', 'platform', 'push_token', 'updated_at_ms'])
        && request.resource.data.schema_version == 1
        && request.resource.data.device_id == deviceId
        && request.resource.data.platform is string
        && request.resource.data.platform.size() <= 32
        && request.resource.data.push_token is string
        && request.resource.data.push_token.size() <= 4096
        && request.resource.data.updated_at_ms is int;
      allow delete: if ownsUser(uid);
    }
  }
}
